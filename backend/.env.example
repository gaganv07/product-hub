# ProductHub Environment Configuration
# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-url>/product_catalogue?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://student_admin:SecurePass123@cluster0.abcde.mongodb.net/product_catalogue?retryWrites=true&w=majority

# Comma-separated allowed frontend origins for CORS in production (e.g. https://producthub.example.com)
CORS_ORIGIN=http://localhost:3000

